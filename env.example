# Copy this file to .env and fill in your key. Never commit .env.
# Choose one: groq | gemini | openrouter | ollama
LLM_PROVIDER=groq

# Free keys:
#   Groq        -> https://console.groq.com/keys
#   Gemini      -> https://aistudio.google.com/apikey
#   OpenRouter  -> https://openrouter.ai/keys  (use ":free" models)
#   Ollama      -> no key, install from https://ollama.com and run: ollama pull llama3.1
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional: override the default model
# LLM_MODEL=openai/gpt-oss-120b

# Optional: extra models for the model list, as provider:model separated by commas
# LLM_EXTRA_MODELS=groq:openai/gpt-oss-20b,gemini:gemini-2.5-pro
